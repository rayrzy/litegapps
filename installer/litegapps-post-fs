#!/system/bin/sh
# Copyright 2020 - 2025 The Litegapps Project
# Litegapps_post-fs (running by magisk in booting)
#

sleep 60s

litegapps_post_fs_version=1.0
litegapps_post_fs_code=1
log=/sdcard/Android/litegapps/litegapps_post-fs.log

rm -rf $log
mkdir -p $(dirname $log)

echo " " >> $log
echo "LiteGapps Post Fs" >> $log
echo "Version=$litegapps_post_fs_version" >> $log
echo "VersionCode=$litegapps_post_fs_code" >> $log
echo "Started -> $(date '+%d/%m/%Y %H:%M:%S')" >> $log
echo " " >> $log

list_package="
com.google.android.ims
com.google.android.carriersetup
com.google.android.gms
com.android.vending
com.google.android.ext.services
com.google.android.apps.restore
com.google.android.contacts
com.google.android.syncadapters.calendar
com.google.android.syncadapters.contacts
com.google.android.apps.restore
com.google.android.pixel.setupwizard
com.google.android.setupwizard
"
list_perm="
android.permission.READ_CALENDAR
android.permission.READ_CALL_LOG 
android.permission.ACCESS_FINE_LOCATION
android.permission.READ_EXTERNAL_STORAGE
android.permission.ACCESS_COARSE_LOCATION
android.permission.READ_PHONE_STATE
android.permission.SEND_SMS
android.permission.CALL_PHONE
android.permission.WRITE_CONTACTS
android.permission.CAMERA
android.permission.WRITE_CALL_LOG
android.permission.PROCESS_OUTGOING_CALLS
android.permission.GET_ACCOUNTS
android.permission.WRITE_EXTERNAL_STORAGE
android.permission.RECORD_AUDIO
android.permission.ACCESS_MEDIA_LOCATION
android.permission.READ_CONTACTS
android.permission.CAMERA
android.permission.BODY_SENSORS
android.permission.ACCESS_NOTIFICATION_POLICY
"

for i in $(pm list package); do
insetapp=$(echo "$i" | head -n1 | cut -d : -f 2)
  	for setapp in $list_package; do
  		if [ "$insetapp" = "$setapp" ]; then
  			# One dump per package instead of one `pm grant` per permission. A
  			# permission the user denied carries USER_SET or USER_FIXED and is left
  			# alone, so a boot never undoes the user's choice. If the dump is empty
  			# or lacks the expected lines, every permission is granted as before.
  			dump=$log.dump
  			dumpsys package "$insetapp" > "$dump" 2>/dev/null
  			for setperm_app in $list_perm; do
  				if [ -s "$dump" ]; then
  					if grep -q "requested permissions:" "$dump" && ! grep -q "$setperm_app" "$dump"; then
  						echo "[SKIP] Not requested $insetapp $setperm_app" >> $log
  						continue
  					fi
  					state=$(grep "^ *$setperm_app: granted=" "$dump" | head -n1)
  					case "$state" in
  						*granted=true*)
  							echo "[SKIP] Already granted $insetapp $setperm_app" >> $log
  							continue ;;
  						*granted=false*USER_SET*|*granted=false*USER_FIXED*)
  							echo "[SKIP] Denied by user $insetapp $setperm_app" >> $log
  							continue ;;
  					esac
  				fi
  				pm grant $insetapp $setperm_app 2>/dev/null && echo "[OK] Set Permissions $insetapp $setperm_app" >> $log \
  				|| echo "[ERROR] Set Permissions $insetapp $setperm_app" >> $log
  			done
  		fi
  	done	
done
rm -f "$log.dump"

echo " " >> $log
echo "# $(date '+%d/%m/%Y %H:%M:%S')" >> $log
echo "###########" >> $log
echo "#   Done  #" >> $log
echo "###########" >> $log


